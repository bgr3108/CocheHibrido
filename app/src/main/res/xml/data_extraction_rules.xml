<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep Room and vehicle preferences together in cloud backups. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/vehicle_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Use the same persistent user data during device-to-device transfer. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/vehicle_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
